{
  "manifest_version": 3,
  "name": "Smart Download Router - Domain & Subfolder Organizer",
  "version": "1.0.0",
  "description": "Auto-organizes downloads into smart subfolders based on website origin, domain rules, and remembered save locations.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Smart Download Router",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "downloads",
    "storage",
    "tabs"
  ]
}
